# ISSUE DISCOVERED (June 2026):
#"froh.txt" was not actually containing normalized FROH values although the pipeline includes the correct normalization step:
# awk -v G=$GENOME_BP '{print $1, $2/G}' roh_total_bp.txt > froh.txt

#but froh.txt contained the same raw ROH lengths as roh_total_bp.txt rather than proportions between 0 and 1.

#downstream population summaries reported mean total ROH length rather than mean FROH

#recreating froh.txt from roh_total_bp.txt using the auto genome length in genome_bp.txt and rerun all downstream joins and summary stats.

#have to run because froh wasn't actually normalized
awk -v G=1264599782 '{print $1, $2/G}' roh_total_bp.txt > froh_new.txt
head froh_new.txt

#preserve and backup old froh.txt
mv froh.txt froh_BAD_rawbp.txt

#create correct froh file
GENOME_BP=$(cat genome_bp.txt)
awk -v G=$GENOME_BP '{print $1, $2/G}' roh_total_bp.txt > froh.txt

#rebuild sorted files
sort froh.txt > froh.sorted.txt
sort metadata_clean.txt > metadata.sorted.txt

#recreate join
join -1 1 -2 1 froh.sorted.txt metadata.sorted.txt > froh_loc_time.txt

#check join size, make sure no samples lost
echo "FROH rows:" $(wc -l < froh.sorted.txt)
echo "Metadata rows:" $(wc -l < metadata.sorted.txt)
echo "Joined rows:" $(wc -l < froh_loc_time.txt)

#inspect joined data
head froh_loc_time.txt

#recompute location + time summaries
awk '{
    loc=$3
    grp=$4
    val=$2

    key=loc FS grp

    sum[key]+=val
    sumsq[key]+=val*val
    n[key]++
}
END{
    for(k in sum){
        mean=sum[k]/n[k]
        var=(sumsq[k]/n[k])-(mean*mean)
        if(var < 0) var=0
        sd=sqrt(var)

        split(k,a,FS)

        print a[1], a[2], n[k], mean, sd
    }
}' froh_loc_time.txt | sort > froh_location_oldnew_summary.txt

#save corrected output
cp froh_location_oldnew_summary.txt \
   froh_location_oldnew_summary_CORRECTED.txt

exit

